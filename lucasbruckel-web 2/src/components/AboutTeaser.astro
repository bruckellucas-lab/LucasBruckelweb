---
import PhotoSlot from './PhotoSlot.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import { about } from '../content/about';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = about[lang];
---
<section class="about section wrap on-grey" aria-labelledby="about-title">
  <div class="grid">
    <figure class="photo" data-reveal="clip">
      <PhotoSlot lang={lang} file={site.photos.about} alt="Lucas Bruckel" pending={t(lang, 'about.photo')} ratio="3 / 4" sizes="(max-width: 980px) 70vw, 30vw" />
    </figure>
    <div class="text" data-reveal>
      <h2 id="about-title" class="t-caption muted">{t(lang, 'about.title')}</h2>
      <p class="lead t-h2">{a.headline}</p>
      <p class="body t-lead measure">{a.lead}</p>
      <p class="body measure">{a.body[0]}</p>
      <a class="btn" href={path(lang, 'about')}>{t(lang, 'about.more')}</a>
    </div>
  </div>
</section>
<style>
  .photo { grid-column: 1 / span 4; }
  .text { grid-column: 6 / span 7; align-self: center; }
  .lead { margin-top: var(--s-5); font-size: clamp(2.75rem, 6vw, 6rem); }
  .body { margin-top: var(--s-5); font-size: 1.125rem; }
  .body.t-lead { font-size: var(--fs-lead); margin-top: var(--s-6); }
  .btn { margin-top: var(--s-7); }
  @media (max-width: 980px) {
    .photo { grid-column: 1 / span 8; }
    .text { grid-column: 1 / -1; margin-top: var(--s-7); }
  }
</style>
