---
import PhotoSlot from './PhotoSlot.astro';
import Status from './Status.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import type { Project } from '../lib/content';

interface Props { lang: Lang; projects: Project[] }
const { lang, projects } = Astro.props;
---
<section class="hero" aria-labelledby="hero-name">
  <h1 id="hero-name" class="name t-monument">
    <span class="row row-1"><span>Lucas</span></span>
    <span class="row row-2"><span>Bruckel</span></span>
  </h1>

  <figure class="portrait">
    <PhotoSlot
      lang={lang}
      file={site.photos.hero}
      alt="Lucas Bruckel"
      pending={t(lang, 'hero.photo')}
      ratio="4 / 5"
      sizes="(max-width: 720px) 62vw, 24vw"
      priority
    />
  </figure>

  <div class="foot">
    <p class="tagline t-lead">{t(lang, 'hero.tagline')}</p>
    <ul class="index" aria-label={t(lang, 'work.title')}>
      {projects.map((p) => (
        <li>
          <a href={path(lang, 'work', p.data.slug)}>
            <span class="index-name">{p.data[lang].title}</span>
            <Status lang={lang} status={p.data.status} />
          </a>
        </li>
      ))}
    </ul>
    <a class="btn btn--solid cta" href="#trabajo">{t(lang, 'hero.cta')}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: clamp(96px, 12vh, 140px) var(--margin) var(--s-7);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
  }

  /* Nombre monumental: dos filas, la segunda alineada a la derecha. */
  .name { position: relative; z-index: 1; display: grid; }
  .row { display: block; overflow: hidden; padding-bottom: 0.02em; }
  .row > span { display: inline-block; }
  .row-2 { text-align: right; margin-top: -0.02em; }

  /* El retrato va adelante del nombre: lo tapa en parte, como un afiche. */
  .portrait {
    position: absolute; z-index: 2;
    left: 50%; top: clamp(140px, 19vh, 210px);
    width: clamp(220px, 24vw, 400px);
    transform: translateX(-38%);
  }

  .foot {
    position: relative; z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) auto;
    gap: var(--s-6) var(--gutter);
    align-items: end;
    margin-top: var(--s-8);
  }
  .tagline { max-width: 22ch; font-weight: 520; }
  .index { list-style: none; border-top: 2px solid var(--black); }
  .index li { border-bottom: 1px solid var(--line); }
  .index a {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 12px 0; text-decoration: none; font-weight: 600;
    transition: padding var(--dur-2) var(--ease-out);
  }
  .index a:hover, .index a:focus-visible { padding-left: 12px; }
  .index .status { font-weight: 500; color: var(--muted); }

  /* Entrada: las filas suben, el retrato se revela de abajo hacia arriba. */
  @media (prefers-reduced-motion: no-preference) {
    .js .row > span { transform: translateY(102%); animation: rise 1.1s var(--ease-out) forwards; }
    .js .row-2 > span { animation-delay: 0.12s; }
    .js .portrait { clip-path: inset(100% 0 0 0); animation: unveil 1.3s var(--ease-in-out) forwards 0.35s; }
    .js .foot { opacity: 0; animation: fade 0.9s ease forwards 0.9s; }
  }
  @keyframes rise { to { transform: translateY(0); } }
  @keyframes unveil { to { clip-path: inset(0 0 0 0); } }
  @keyframes fade { to { opacity: 1; } }

  @media (max-width: 980px) {
    .foot { grid-template-columns: 1fr 1fr; }
    .cta { grid-column: 1 / -1; justify-self: start; }
  }
  @media (max-width: 720px) {
    .hero { min-height: auto; padding-top: 104px; grid-template-rows: auto auto auto; }
    .name { font-size: clamp(5.25rem, 27vw, 9rem); }
    .portrait { position: relative; left: auto; top: auto; transform: none; width: 62%; margin: calc(clamp(5.25rem, 27vw, 9rem) * -0.2) auto 0 0; }
    .foot { grid-template-columns: 1fr; margin-top: var(--s-7); }
    .tagline { max-width: none; }
  }
</style>
