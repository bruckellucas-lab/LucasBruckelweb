---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import WorkItem from './WorkItem.astro';
import NowList from './NowList.astro';
import AboutTeaser from './AboutTeaser.astro';
import Expertise from './Expertise.astro';
import WritingTeaser from './WritingTeaser.astro';
import Contact from './Contact.astro';
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';
import { path, otherLang } from '../i18n/routes';
import { getProjects } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const projects = (await getProjects()).filter((p) => p.data.featured);
---
<Base lang={lang} altPath={path(otherLang(lang), 'home')}>
  <Hero lang={lang} projects={projects} />

  <section id="trabajo" aria-labelledby="work-title">
    <div class="work-head wrap" data-reveal>
      <h2 id="work-title" class="t-display">{t(lang, 'work.title')}</h2>
      <p class="t-lead muted">{t(lang, 'work.intro')}</p>
    </div>
    {projects.map((p) => <WorkItem lang={lang} project={p} />)}
  </section>

  <NowList lang={lang} />
  <AboutTeaser lang={lang} />
  <Expertise lang={lang} />
  <WritingTeaser lang={lang} />
  <Contact lang={lang} />
</Base>

<style>
  .work-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-5);
    padding-top: var(--section); padding-bottom: var(--s-8);
  }
  .work-head p { max-width: 24ch; }
</style>
