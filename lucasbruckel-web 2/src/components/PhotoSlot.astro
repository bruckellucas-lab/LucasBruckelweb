---
import { Image } from 'astro:assets';
import { personalPhoto } from '../lib/images';
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Archivo aprobado en src/assets/photos/ o null. */
  file: string | null;
  alt: string;
  /** Texto del placeholder cuando la foto todavía no está aprobada. */
  pending: string;
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { lang, file, alt, pending, ratio = '4 / 5', sizes = '(max-width: 720px) 80vw, 30vw', priority = false, class: cls } = Astro.props;
const photo = personalPhoto(file);
---
{photo ? (
  <Image
    src={photo}
    alt={alt}
    class:list={['photo-bw', cls]}
    style={`aspect-ratio:${ratio};object-fit:cover;width:100%;height:auto`}
    widths={[400, 700, 1000, 1400]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
) : (
  <div class:list={['photo-slot', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={pending}>
    <span>{t(lang, 'photo.pending')}: {pending}</span>
  </div>
)}
