---
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';
interface Props { lang: Lang; status: 'beta' | 'demo' | 'prototype' }
const { lang, status } = Astro.props;
---
<span class={`status status--${status}`}><span class="status-mark" aria-hidden="true"></span>{t(lang, `status.${status}`)}</span>
