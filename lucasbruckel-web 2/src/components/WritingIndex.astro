---
import Base from '../layouts/Base.astro';
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';
import { path, otherLang } from '../i18n/routes';
import { getWriting, postSlug, formatDate } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = await getWriting(lang);
---
<Base lang={lang} title={t(lang, 'writing.title')} description={t(lang, 'writing.intro')} altPath={path(otherLang(lang), 'writing')}>
  <section class="wrap page">
    <h1 class="t-monument title">{t(lang, 'writing.title')}</h1>
    <p class="t-lead muted intro">{t(lang, 'writing.intro')}</p>
    {posts.length === 0 ? (
      <p class="empty t-h3">{t(lang, 'writing.empty')}</p>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={path(lang, 'writing', postSlug(p.id))}>
              <span class="t-caption muted">{formatDate(p.data.date, lang)}</span>
              <span class="t-h3">{p.data.title}</span>
              <span class="muted">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
<style>
  .page { padding-top: clamp(120px, 16vh, 180px); padding-bottom: var(--section); }
  .title { font-size: clamp(4rem, 16vw, 16rem); margin-left: -0.04em; }
  .intro { margin-top: var(--s-6); max-width: 34ch; }
  .empty { margin-top: var(--s-9); padding-top: var(--s-5); border-top: 2px solid var(--black); }
  .posts { list-style: none; margin-top: var(--s-9); border-top: 2px solid var(--black); }
  .posts a { display: grid; gap: var(--s-2); padding: var(--s-6) 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .posts a:hover .t-h3 { text-decoration: underline; text-decoration-thickness: 3px; }
</style>
