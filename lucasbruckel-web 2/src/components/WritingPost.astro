---
import Base from '../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';
import { path, otherLang } from '../i18n/routes';
import { formatDate } from '../lib/content';
interface Props { lang: Lang; post: CollectionEntry<'writing'>; altSlug?: string }
const { lang, post, altSlug } = Astro.props;
const { Content } = await render(post);
---
<Base lang={lang} title={post.data.title} description={post.data.description} type="article"
  altPath={altSlug ? path(otherLang(lang), 'writing', altSlug) : path(otherLang(lang), 'writing')}>
  <article class="wrap post">
    <a class="link t-caption" href={path(lang, 'writing')}>{t(lang, 'writing.title')}</a>
    <p class="t-caption muted date">{formatDate(post.data.date, lang)}</p>
    <h1 class="t-display">{post.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>
</Base>
<style>
  .post { padding-top: clamp(120px, 16vh, 180px); padding-bottom: var(--section); }
  .date { margin-top: var(--s-7); }
  h1 { margin-top: var(--s-4); max-width: 18ch; }
  .prose { margin-top: var(--s-8); max-width: 40rem; font-size: 1.1875rem; line-height: 1.65; }
  .prose :global(p + p) { margin-top: 1.1em; }
  .prose :global(h2) { margin-top: 2em; font-size: 1.75rem; font-weight: 760; font-stretch: 80%; line-height: 1.15; }
  .prose :global(a) { text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
</style>
