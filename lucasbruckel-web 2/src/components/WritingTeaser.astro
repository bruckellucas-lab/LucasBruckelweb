---
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';
import { path } from '../i18n/routes';
import { getWriting, postSlug, formatDate } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = (await getWriting(lang)).slice(0, 3);
---
{posts.length > 0 && (
  <section class="writing section wrap" aria-labelledby="writing-title">
    <h2 id="writing-title" class="t-display" data-reveal>{t(lang, 'writing.title')}</h2>
    <ul class="posts">
      {posts.map((p) => (
        <li data-reveal>
          <a href={path(lang, 'writing', postSlug(p.id))}>
            <span class="t-caption muted">{formatDate(p.data.date, lang)}</span>
            <span class="t-h3">{p.data.title}</span>
            <span class="muted">{p.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="btn" href={path(lang, 'writing')}>{t(lang, 'writing.title')}</a>
  </section>
)}
<style>
  .posts { list-style: none; margin-top: var(--s-8); border-top: 2px solid var(--black); }
  .posts a { display: grid; gap: var(--s-2); padding: var(--s-6) 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .btn { margin-top: var(--s-7); }
</style>
