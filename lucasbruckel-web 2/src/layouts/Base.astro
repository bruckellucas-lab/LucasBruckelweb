---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n/ui';
import { htmlLang } from '../i18n/routes';
import { getWriting } from '../lib/content';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta de la imagen Open Graph dentro de /public (1200 × 630). */
  ogImage?: string;
  /** Ruta equivalente en el otro idioma, para el selector y hreflang. */
  altPath: string;
  type?: 'website' | 'article';
}

const { lang, title, description, ogImage = lang === 'en' ? '/og/default-en.png' : '/og/default.png', altPath, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : t(lang, 'meta.title');
const pageDescription = description ?? t(lang, 'meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(altPath, Astro.site);
const esUrl = lang === 'es' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;
const hasWriting = (await getWriting(lang)).length > 0;
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-AR" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {site.analytics && <script defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#contenido">{t(lang, 'skip')}</a>
    <Header lang={lang} altPath={altPath} hasWriting={hasWriting} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Revela elementos con [data-reveal] una sola vez al entrar en pantalla.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }

      // Botones "copiar" (mail y link del caso de estudio).
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const value = btn.dataset.copy === 'url' ? window.location.href : btn.dataset.copy ?? '';
          const label = btn.querySelector('[data-label]');
          try {
            await navigator.clipboard.writeText(value);
            if (label) {
              const original = label.textContent;
              label.textContent = btn.dataset.done ?? '';
              setTimeout(() => (label.textContent = original), 2200);
            }
          } catch {
            if (btn.dataset.copy?.includes('@')) window.location.href = `mailto:${btn.dataset.copy}`;
          }
        });
      });
    </script>
  </body>
</html>
